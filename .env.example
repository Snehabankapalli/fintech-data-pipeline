# AWS
AWS_ACCESS_KEY_ID=your_access_key
AWS_SECRET_ACCESS_KEY=your_secret_key
AWS_REGION=us-east-1
S3_RAW_BUCKET=your-fintech-raw-bucket
S3_PROCESSED_BUCKET=your-fintech-processed-bucket

# Snowflake
SNOWFLAKE_ACCOUNT=your_account.us-east-1
SNOWFLAKE_USER=your_user
SNOWFLAKE_PASSWORD=your_password
SNOWFLAKE_WAREHOUSE=FINTECH_WH
SNOWFLAKE_DATABASE=FINTECH_DB
SNOWFLAKE_SCHEMA=RAW
SNOWFLAKE_ROLE=DATA_ENGINEER

# Fiserv Payment Processor API
FISERV_API_BASE_URL=https://api.fiserv.com/v1
FISERV_API_KEY=your_fiserv_api_key
FISERV_CLIENT_ID=your_client_id
FISERV_CLIENT_SECRET=your_client_secret

# Pipeline Config
BATCH_SIZE=10000
MAX_RETRIES=3
PIPELINE_ENV=production
